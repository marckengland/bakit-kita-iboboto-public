# =============================================================================
# Bakit Kita Iboboto - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# --- PostgreSQL (Prisma) ---
# Isolated source-only development default; separate project, database and ports.
# Matches docker-compose.yml. Do not reuse settings from an existing installation.
# Prisma 7 supports schema, connection_limit and connect_timeout URL parameters.
# The old pool_timeout option is rejected. See docs/PRISMA.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/bakit_kita_iboboto_populated"

# --- Elasticsearch (search index) ---
# Optional for browsing profiles. Full-text directory search requires this service.
# Autocomplete has a PostgreSQL fallback. An unset URL defaults to localhost:59201 in this copy.
ELASTICSEARCH_URL="http://localhost:59201"

# --- Redis (optional development cache; required for production sessions) ---
# Production sessions require an explicit REDIS_URL and a working Redis service.
# They do not fall back to memory. Development/test sessions use memory.
REDIS_URL="redis://localhost:56380"
# Local development/CI only. Production sessions reject disabled Redis.
REDIS_DISABLED="true"

# Public case/context reads need a migrated database and individually approved packets.
# Keep false until review is complete. False is also the safe feature rollback.
PUBLIC_CASE_RECORDS_ENABLED="false"

# --- AI providers (chatbot + research pipeline) ---
# Keys are optional for local browsing. Leave them empty until you need AI.
# Provider selection is currently held in memory and resets on server restart.
# The chatbot and verifier default to Gemini. Research uses Gemini web grounding.
# Background work is disabled unless explicitly enabled below.
# AI findings become review proposals with citations; research does not publish them.
# Enabling research can incur provider charges. Use a development database.
# See docs/ARCHITECTURE.md and docs/DATA.md for manual review and remaining limits.
DATA_PIPELINE_ENABLED="false"
AI_RESEARCH_ENABLED="false"

# Google Gemini: required only when using Gemini or running AI research.
GOOGLE_AI_API_KEY=""

# Anthropic Claude — required only if you switch the chatbot/verifier provider to "claude".
ANTHROPIC_API_KEY=""

# OpenAI — required if the chatbot provider is "openai".
OPENAI_API_KEY=""

# DeepSeek — required if the chatbot provider is "deepseek".
DEEPSEEK_API_KEY=""

# OpenRouter — required if the chatbot provider is "openrouter" (open-weight models:
# Kimi, GLM, Llama, Qwen, etc.).
OPENROUTER_API_KEY=""

# --- Cron authorization ---
# Shared secret required by scheduled routes (e.g. /api/cron/ai-research).
# Set a long random secret before deploying. Do not use this empty local value publicly.
# Every cron route returns 503 if the secret is unset, or 401 for invalid auth.
# Requests must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# --- Admin surface (DANGER) ---
# The admin area (/admin/* and /api/admin/*) is NOT protected by real
# authentication yet and is therefore DISABLED by default (returns 404).
# Production always returns 404, even if this flag is true. Only enable it
# in development/test until proper admin auth is implemented. See SECURITY.md.
ADMIN_ENABLED="false"

# --- Private contact (Resend; disabled until configured) ---
# Use a verified Resend sender and a private inbox. These are server-only values.
# Keep the real receiver and API key out of this example and public source.
# PRIVATE_CONTACT_ORIGIN must be the exact HTTPS origin, without a trailing slash.
# HTTP is accepted only for loopback development. A working REDIS_URL is required.
PRIVATE_CONTACT_ENABLED="false"
PRIVATE_CONTACT_ORIGIN=""
PRIVATE_CONTACT_FROM=""
PRIVATE_CONTACT_TO=""
RESEND_API_KEY=""
