# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# prisma dev sqlite (accidentally left over from an early prototype)
/prisma/*.db
/prisma/*.db-journal

# ad-hoc data dumps, temp copies, and script logs left at the repo root
/education-dump.txt
/link-authors-*.txt
/*-dump.txt
/temp_*.txt
/semantic

# elasticsearch / redis local volumes if ever mounted here
/elasticsearch_data
/redis_data

.playwright-mcp

# graphify generated knowledge-graph output (regenerable; embeds local paths)
/graphify-out

# Local agent metadata and database backups
/.serena/
/.spec-workflow/
/backups/
/backup*.sql
/backup*.dump
