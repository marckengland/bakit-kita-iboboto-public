model CaseEvent {
  id String @id
  controversyId String
  kind CaseEventKind
  outcome ReviewedCaseOutcome?
  relief CaseReliefType?
  evidenceBasis CaseEvidenceBasis?
  finality CaseFinality @default(unknown)
  eventDate String?
  jurisdiction String?
  court String?
  caseNumber String?
  summary String
  selectedRelief Boolean @default(false)
  appliesToEventId String?
  reviewState ResearchReviewState @default(pending)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Controversy Controversy @relation("CaseRecordEvents", fields: [controversyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "case_review_event_parent_fk")
  SelectedBy Controversy[] @relation("SelectedCaseOutcome")
  AppliesTo CaseEvent? @relation("CaseEventRelief", fields: [appliesToEventId, controversyId], references: [id, controversyId], onDelete: Restrict, onUpdate: Restrict, map: "case_review_relief_owner_fk")
  ReliefEvents CaseEvent[] @relation("CaseEventRelief")
  SourceAttribution SourceAttribution[] @relation("CaseEventSources")
  @@unique([id, controversyId])
  @@index([controversyId])
}

